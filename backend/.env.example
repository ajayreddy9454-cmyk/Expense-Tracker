# =====================================================================
# Flask
# =====================================================================
# REQUIRED in production. Use a long random value.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# =====================================================================
# Database connection
# =====================================================================
# OPTION A (preferred on Render): a full connection URL.
#   mysql+pymysql://USER:PASSWORD@HOST:PORT/DBNAME?charset=utf8mb4
# DATABASE_URL=mysql+pymysql://avnadmin:password@host.aivencloud.com:26932/defaultdb?charset=utf8mb4

# OPTION B: individual components (used by the original Aiven setup).
DB_HOST=your-aiven-host.aivencloud.com
DB_PORT=12345
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=your-aiven-password

# =====================================================================
# Aiven CA Certificate (required for Aiven MySQL SSL)
# =====================================================================
# Option A - Path to a local CA certificate file:
# DB_SSL_CA=C:/path/to/ca.pem
#
# Option B - The PEM content itself (pasted inline as a multi-line string).
#            Best suited for Render / cloud deployments where you paste the
#            full certificate content into the environment variable dashboard.
#
# DB_SSL_CA=-----BEGIN CERTIFICATE-----
# MIIEIDCCAwig...
# ...
# -----END CERTIFICATE-----

# =====================================================================
# Optional
# =====================================================================
# Render injects PORT automatically. Local dev default is 5000.
# PORT=5000

